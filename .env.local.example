# MongoDB
MONGODB_URI=mongodb://localhost:27017/naprocs-newsletter

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Doubles as the site's public base URL — used to build absolute URLs in sitemap.xml,
# robots.txt, article canonical/OG links, and JSON-LD (Module 10). Set this to the real
# production domain when deploying; no separate NEXT_PUBLIC_SITE_URL is used, to avoid
# two URLs that both need to be kept in sync.
NEXTAUTH_URL=http://localhost:3000

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Upstash Redis (rate limiting — lib/rate-limit.ts)
# Create a free database at https://console.upstash.com/redis
# If left blank, rate limiting fails open (all requests allowed) with a console warning.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
